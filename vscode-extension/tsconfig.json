{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node", "mocha"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "src/__tests__/**",
    "src/**/__tests__/**"
  ]
}