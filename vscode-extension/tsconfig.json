{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node", "mocha"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["out", "node_modules", "src/**/__tests__/**", "vitest.config.ts", "vitest.setup.ts"]
}
